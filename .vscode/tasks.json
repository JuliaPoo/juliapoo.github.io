{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-to-html",
      "type": "process",
      "command": "/home/tessa/.local/bin/typst",
      "args": [
        "compile",
        "${file}",
        "${fileDirname}/${fileBasenameNoExtension}.html",
        "--features", "html",
        "--input", "mode=web"
        // "--pretty" // uncomment if your postprocess prefers unminified HTML (minified by default since Typst 0.15)
      ],
      "problemMatcher": []
    },
    {
      "label": "compile-to-pdf",
      "type": "process",
      "command": "/home/tessa/.local/bin/typst",
      "args": [
        "compile",
        "${file}",
        "${fileDirname}/${fileBasenameNoExtension}.pdf",
        "--features", "html",
        "--input", "mode=print"
      ],
      "problemMatcher": []
    },
    {
      "label": "Export as Jekyll Template",
      "type": "process",
      "command": "python",
      "args": [
        "typst-postprocess.py",
        "${file}"
      ],
      "dependsOn": ["compile-to-html", "compile-to-pdf"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true // Set to false if you're debugging sub-tasks
      },
      "problemMatcher": []
    }
  ]
}